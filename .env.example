VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Canonical ARRIYIA app origin (e.g. https://app.nolmark.co), no
# trailing slash. When set, Supabase Auth redirect URLs (password reset)
# use this instead of window.location.origin, so they stay correct even if
# the page happens to load from a different domain (e.g. the corporate
# site). Leave unset for local dev — window.location.origin is used instead.
VITE_SITE_URL=
